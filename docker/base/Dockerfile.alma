# Build from AlmaLinux 9 (current 9.7)
FROM almalinux:9

# Install EPEL for ROOT and other packages
RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf update -y

# Install pre-reqs.  ROOT is split into sub-packages in Alma's package manager.
# Several common Root sub-packages are included.
RUN dnf groupinstall -y "Development Tools" && \
    dnf install -y --allowerasing \
    doxygen \
    emacs \
    ffmpeg-free \
    ffmpeg-free-devel \
    gsl \
    gsl-devel \
    hdf5 \
    hdf5-devel \
    less \
    boost-devel \
    eigen3-devel \
    libXpm-devel \
    openmpi \
    openmpi-devel \
    rsync \
    swig \
    valgrind \
    git \
    vim \
    cmake \
    wget \
    curl \
    tcl \
    tcl-devel \
    libXft-devel \
    libXext-devel \
    fftw-devel \
    zlib-devel \
    python3 \
    python3-pip \
    python3-devel \
    root \
    python3-root \
    root-notebook \
    root-fftw \
    root-gdml \
    root-genvector \
    root-minuit \
    root-mlp \
    root-net-http \
    root-roofit \
    root-roostats \
    root-spectrum \
    root-tmva \
    && dnf clean all

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Set ROOT environment variables, installed via Alma's package manager
# using typical install paths
ENV ROOTSYS="/usr"
ENV ROOT_DIR="/usr/share/root/cmake"
ENV ROOT_INCLUDE_PATH="/usr/include/root"
ENV CMAKE_PREFIX_PATH="${ROOT_DIR}"
ENV LD_LIBRARY_PATH="/usr/lib64/root"

# Ensure OpenMPI tools on PATH
ENV OPENMPI_DIR="/usr/lib64/openmpi"
ENV PATH="${OPENMPI_DIR}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${OPENMPI_DIR}/lib:${LD_LIBRARY_PATH}"

# Install additional useful python packages
RUN pip3 install --upgrade pip \
    && pip3 install --no-cache-dir --upgrade --ignore-installed "packaging>=23.0" \
    && pip3 install --no-cache-dir \
    emcee==2.2.1 \
    h5py \
    hic \
    hsluv \
    jupyter \
    matplotlib \
    nbdime \
    numpy \
    pandas \
    pathlib \
    ptemcee \
    pyhepmc \
    pyyaml \
    scikit-learn \
    scipy \
    seaborn \
    tqdm

# Symlink python
RUN ln -s /usr/bin/python3 /usr/bin/python

# Configure ROOT environment variables (installed via package manager, usually in standard paths)
# checking if env vars are needed, usually /usr/bin/root is in path.
# We might need to source /usr/bin/thisroot.sh or similar if it exists, but usually RPM installs are in system path.
# However, for consistency with old dockerfile, we might set ROOTSYS if possible, but standard install puts headers in /usr/include/root etc.

# Install the current Alma Linux package manage LHAPDF package.
# Earlier versions of LHAPDF were removed from the Alma Linux package manager.
RUN dnf install -y --allowerasing lhapdf lhapdf-devel && \
    dnf clean all
ENV LHAPATH='/usr/share/LHAPDF:/home/jetscape-user/.local/share/LHAPDF'

# Install HepMC 3.2.6
# Download to a temporary file then extract to avoid streaming/tar issues with buildx/QEMU
RUN curl -SLf --progress-bar --retry 5 --retry-delay 5 --max-time 600 "http://hepmc.web.cern.ch/hepmc/releases/HepMC3-3.2.6.tar.gz" -o /tmp/HepMC3-3.2.6.tar.gz \
    && tar --no-same-owner -xzf /tmp/HepMC3-3.2.6.tar.gz -C /usr/local \
    && rm -f /tmp/HepMC3-3.2.6.tar.gz \
    && cd /usr/local \
    && mkdir hepmc3-build \
    && cd hepmc3-build \
    && cmake ../HepMC3-3.2.6 -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_INSTALL_LIBDIR=lib -DHEPMC3_ENABLE_ROOTIO=ON -DHEPMC3_BUILD_EXAMPLES=ON -DROOT_DIR=${ROOT_DIR} -DCMAKE_CXX_STANDARD=17 -DHEPMC3_CXX_STANDARD=17 \
    && make -j$(nproc) install \
    && rm -r /usr/local/hepmc3-build

ENV LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"

# Install Pythia8 with HepMC3-3.2.6 (that is needed by SMASH)
# The previous pythia.org URL returning 404, so using GitLab instead.
ARG pythiaV="8315"
RUN curl -SLf --progress-bar --retry 5 --retry-delay 5 --max-time 600 "https://gitlab.com/Pythia8/releases/-/archive/pythia${pythiaV}/releases-pythia${pythiaV}.tar.gz" -o /tmp/pythia${pythiaV}.tgz \
    && mkdir -p /usr/local/pythia${pythiaV} \
    && tar --no-same-owner --strip-components=1 -xzf /tmp/pythia${pythiaV}.tgz -C /usr/local/pythia${pythiaV} \
    && rm -f /tmp/pythia${pythiaV}.tgz \
    && cd /usr/local/pythia${pythiaV} \
    && ./configure --enable-shared --prefix=/usr/local/ --with-hepmc3=/usr/local/HepMC3-3.2.6 --with-lhapdf6 \
    && make -j$(nproc) \
    && make -j$(nproc) install

# Environment setup
ARG username=jetscape-user
ENV JETSCAPE_DIR="/home/${username}/JETSCAPE"
ENV SMASH_DIR="${JETSCAPE_DIR}/external_packages/smash/smash_code"
ENV EIGEN3_ROOT /usr/include/eigen3
ENV PYTHIA8DIR /usr/local/
ENV PYTHIA8 /usr/local/
ENV PYTHIA8_ROOT_DIR /usr/local/
ENV PATH $PATH:$PYTHIA8DIR/bin

# Environment modules
# Download archive to /tmp first to avoid streaming/tar issues under buildx/QEMU
RUN curl -SLf --progress-bar --retry 5 --retry-delay 5 --max-time 600 "https://sourceforge.net/projects/modules/files/Modules/modules-4.5.1/modules-4.5.1.tar.gz" -o /tmp/modules-4.5.1.tar.gz \
    && tar --no-same-owner -xzf /tmp/modules-4.5.1.tar.gz -C /usr/local \
    && rm -f /tmp/modules-4.5.1.tar.gz \
    && cd /usr/local/modules-4.5.1 \
    && ./configure --prefix=/usr/local --modulefilesdir=/heppy/modules \
    && make -j$(nproc) \
    && make -j$(nproc) install

# User setup
ARG id=1234
RUN groupadd -g ${id} ${username} \
    && useradd --create-home --home-dir /home/${username} -u ${id} -g ${username} ${username}
USER ${username}
ENV HOME /home/${username}
WORKDIR ${HOME}

ENTRYPOINT /bin/bash
