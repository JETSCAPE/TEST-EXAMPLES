<?xml version="1.0"?>
<!-- C-SCAPE regression test: pp, PythiaGun with the full PYTHIA event graph (MPI + beam remnants)
     carried into the JetScapeEventGraph, vacuum MATTER, colored hadronization 
     Requires no optional external modules. -->
<jetscape>

  <nEvents> 50 </nEvents>
  <outputFilename>test_pp_fullgraph_colored</outputFilename>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>
  <JetScapeWriterHepMC> on </JetScapeWriterHepMC>
  <JetScapeWriterFinalStatePartonsAscii> on </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>

  <Random>
    <seed>12</seed>
  </Random>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>20</pTHatMin>
      <pTHatMax>40</pTHatMax>
      <eCM>5020</eCM>
      <LinesToRead>
        HardQCD:all = on
        PartonLevel:MPI = on
      </LinesToRead>
      <fullGraph>1</fullGraph>
      <nScatter>1</nScatter>
      <takeRemnants>1</takeRemnants>
    </PythiaGun>
  </Hard>

  <!--Eloss Modules -->
  <Eloss>
    <deltaT> 0.1 </deltaT>
    <maxT> 20 </maxT>
    <Matter>
      <Q0> 1.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
    </Matter>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colored</name>
    <eCMforHadronization>5020</eCMforHadronization>
  </JetHadronization>

</jetscape>
