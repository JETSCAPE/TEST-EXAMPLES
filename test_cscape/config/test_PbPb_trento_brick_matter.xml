<?xml version="1.0"?>
<!-- C-SCAPE regression test: Pb+Pb 5.02 TeV, TRENTo initial state (hard-process positions),
     static brick medium, in-medium MATTER with recoils and broadening, colorless hadronization 
     Requires LBT tables for MATTER recoils (external_packages/get_lbtTab.sh); no optional modules. -->
<jetscape>

  <nEvents> 10 </nEvents>
  <outputFilename>test_PbPb_trento_brick_matter</outputFilename>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>
  <JetScapeWriterHepMC> on </JetScapeWriterHepMC>
  <JetScapeWriterFinalStatePartonsAscii> on </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>

  <Random>
    <seed>1</seed>
  </Random>

  <!-- Inital State Module  -->
  <IS>
    <Trento> </Trento>
  </IS>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>20</pTHatMin>
      <pTHatMax>30</pTHatMax>
      <eCM>5020</eCM>
    </PythiaGun>
  </Hard>

  <!--Preequilibrium Dynamics Module -->
  <Preequilibrium>
    <NullPreDynamics> </NullPreDynamics>
  </Preequilibrium>

  <!-- Hydro  Module  -->
  <Hydro>
    <Brick bjorken_expansion_on="false" start_time="0.6"> </Brick>
  </Hydro>

  <!--Eloss Modules -->
  <Eloss>
    <Matter>
      <in_vac> 0 </in_vac>
      <Q0> 2.0 </Q0>
      <recoil_on> 1 </recoil_on>
      <broadening_on> 1 </broadening_on>
      <qhat0> -2.0 </qhat0>
    </Matter>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
  </JetHadronization>

</jetscape>
