<?xml version="1.0"?>
<!-- C-SCAPE regression test: pp, PythiaGun + vacuum MATTER, colorless (string) hadronization 
     Requires no optional external modules. -->
<jetscape>

  <nEvents> 50 </nEvents>
  <outputFilename>test_pp_vacuum_colorless</outputFilename>
  <JetScapeWriterAscii> on </JetScapeWriterAscii>
  <JetScapeWriterHepMC> on </JetScapeWriterHepMC>
  <JetScapeWriterFinalStatePartonsAscii> on </JetScapeWriterFinalStatePartonsAscii>
  <JetScapeWriterFinalStateHadronsAscii> on </JetScapeWriterFinalStateHadronsAscii>

  <Random>
    <seed>10</seed>
  </Random>

  <!-- Hard Process -->
  <Hard>
    <PythiaGun>
      <pTHatMin>100</pTHatMin>
      <pTHatMax>200</pTHatMax>
      <eCM>5020</eCM>
    </PythiaGun>
  </Hard>

  <!--Eloss Modules -->
  <Eloss>
    <deltaT> 0.1 </deltaT>
    <maxT> 20 </maxT>
    <Matter>
      <Q0> 1.0 </Q0>
      <in_vac> 1 </in_vac>
      <vir_factor> 0.25 </vir_factor>
      <qhat0> 0.0 </qhat0>
      <alphas> 0.25 </alphas>
    </Matter>
  </Eloss>

  <!-- Jet Hadronization Module -->
  <JetHadronization>
    <name>colorless</name>
  </JetHadronization>

</jetscape>
